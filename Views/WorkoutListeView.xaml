<UserControl x:Class="SwimBikeRun.Views.WorkoutListeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- Listenansicht der Trainingseinheiten -->
    <ListView ItemsSource="{Binding Trainingseinheiten}"
              SelectedItem="{Binding AusgewähltesWorkout}">
        <ListView.View>
            <GridView>
                <!-- StringFormat formatiert das Datum schön deutsch (Tag.Monat.Jahr) -->
                <GridViewColumn Header="// ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                <GridViewColumn Header="// Datum" DisplayMemberBinding="{Binding Datum, StringFormat=dd.MM.yyyy}" Width="90"/>
                <GridViewColumn Header="// Sportart" DisplayMemberBinding="{Binding Sportart}" Width="80"/>
                <GridViewColumn Header="// Dauer (Min)" DisplayMemberBinding="{Binding DauerMinuten}" Width="90"/>
                <GridViewColumn Header="// Distanz (km)" DisplayMemberBinding="{Binding DistanzKm}" Width="90"/>
                <GridViewColumn Header="// Durchschnitt-Pace (km/h)" DisplayMemberBinding="{Binding DurchschnittsPace}" Width="150"/>
                <GridViewColumn Header="// Notiz" DisplayMemberBinding="{Binding Notiz}" Width="200"/>
            </GridView>
        </ListView.View>
    </ListView>
</UserControl>