<Window x:Class="SwimBikeRun.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SwimBikeRun"
        mc:Ignorable="d"
        Title="SwimBikeRun" Height="450" Width="800">
    
    <DockPanel>
        <!-- Top: Toolbar -->
        <StackPanel DockPanel.Dock="Top" 
                    Orientation="Horizontal" 
                    Background="DarkOrange" 
                    Height="30">
            <Button Content="Einstellungen" Width="80" Margin="5"/>
            <Button Content="Neu" Width="80" Margin="5"/>
            <Button Content="Speichern" Width="80" Margin="5"/>
            <Button Content="Löschen" Width="80" Margin="5"/>
            <Button Content="Exportieren" Width="80" Margin="5"/>
        </StackPanel>

        <!-- Left: Navigation -->
        <StackPanel DockPanel.Dock="Left" 
                    Background="DarkOrange" 
                    Width="100">
            <Button Content="Swim" 
                    Height="45" 
                    Margin="10,5"/>
            <Button Content="Bike" 
                    Height="45" 
                    Margin="10,5"/>
            <Button Content="Run" 
                    Height="45" 
                    Margin="10,5"/>
        </StackPanel>

        <!-- Center: Hauptbereich - Die Tabelle für deine Trainingseinheiten--> 
        <ListView x:Name="WorkoutsListView" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <!-- StringFormat formatiert das Datum schön deutsch (Tag.Monat.Jahr) -->
                    <GridViewColumn Header="Datum" DisplayMemberBinding="{Binding Datum, StringFormat=dd.MM.yyyy}" Width="90"/>
                    <GridViewColumn Header="Sportart" DisplayMemberBinding="{Binding Name}" Width="110"/>
                    <GridViewColumn Header="Dauer (Min)" DisplayMemberBinding="{Binding DauerMinuten}" Width="80"/>
                    <GridViewColumn Header="Distanz (km)" DisplayMemberBinding="{Binding DistanzKm}" Width="80"/>
                    <GridViewColumn Header="Notiz" DisplayMemberBinding="{Binding Notiz}" Width="300"/>
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
    
</Window>
